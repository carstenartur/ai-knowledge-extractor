<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.carstenartur</groupId>
  <artifactId>ai-knowledge-release</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <name>AI Knowledge Extractor release driver</name>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <goals>exec:exec@publish-central</goals>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <executions>
          <execution>
            <id>publish-central</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <workingDirectory>${project.basedir}/..</workingDirectory>
              <executable>bash</executable>
              <arguments>
                <argument>-eu</argument>
                <argument>-c</argument>
                <argument><![CDATA[
                  test "$(git rev-parse HEAD)" = "$RELEASE_SHA" || { echo "Unexpected release commit" >&2; exit 1; }
                  grep -Fxq "projectVersion=$VERSION" gradle.properties || { echo "Unexpected release version" >&2; exit 1; }
                  exec gradle --no-daemon -PpublicDistribution=true publishAndReleaseToMavenCentral
                ]]></argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
